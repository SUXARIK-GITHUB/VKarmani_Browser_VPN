{
  "manifest_version": 3,
  "name": "VKarmani Browser VPN",
  "version": "0.4.0",
  "description": "Browser-only VKarmani VPN for Remnawave VLESS/REALITY subscriptions.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "privacy",
    "proxy",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VKarmani Browser VPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
